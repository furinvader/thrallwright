{
  "name": "thrallwright",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/dev.mjs",
    "test": "node --test scripts/*.test.mjs && node scripts/test.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm check:deps && pnpm format:check && pnpm lint && pnpm build && pnpm test",
    "check:deps": "node scripts/check-dependencies.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  }
}
